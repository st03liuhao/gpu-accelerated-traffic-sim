+// [lcrl-rl] The vehicle's segment (rl::Chain): from the current edge along its path through every
+// node where all lanes continue and none has to be chosen, until a controlled intersection, a
+// diverge or lane drop (some lane does not continue, or the route uses only some lanes), the end
+// of the path, or rl::kLookahead. Also the upstream path edges for the lag search. Returns the
+// controlled intersection at the end (-1 if none).
+__device__ int rlBuildChain(rl::Chain& C, const LC::B18TrafficVehicle& v, const uint* indexPathVec,
+                            uint indexPathVec_d_size, const uint* laneMapper, const LC::B18EdgeData* edgesData,
+                            LC::B18IntersectionData* intersections, const ix::View& ixv, const lg::View& G,
+                            uint currentEdge_d) {
+  const float pos = v.posInLaneM;
+  C.n = 1; C.nBack = 0;
+  C.seg[0] = rl::Seg{(int)currentEdge_d, (int)edgesData[currentEdge_d].numLines, edgesData[currentEdge_d].length, -pos, 0};
+  float endRel = C.seg[0].len - pos;
+  uint idx = v.indexPathCurr;
+  unsigned ok = 0;
+  int ixEnd = -1;
+  unsigned usedSlots = 0;                // lane slots (current-edge index - kLaneLo) with a lane ahead of the vehicle
+  for (int k = 0; k < C.seg[0].nl; ++k) {
+    const float2 sp = lg::span(G, C.seg[0].edge, k, C.seg[0].len);
+    if (sp.y > sp.x && sp.y > pos && k - rl::kLaneLo < 32) usedSlots |= 1u << (k - rl::kLaneLo);
+  }
+  while (true) {
+    const rl::Seg S = C.seg[C.n - 1];
+    const unsigned alive = rlAliveAtEnd(G, S.edge, S.nl, S.len);
+    const uint nextE = idx + 1 < indexPathVec_d_size ? indexPathVec[idx + 1] : END_OF_PATH;
+    if (nextE == END_OF_PATH) { ok = alive; break; }
+    const int nd = (int)laneMapper[nextE];
+    const int node = ixv.nNodes > 0 ? ixv.edgeNode[S.edge] : -1;
+    if (node >= 0) {                     // controlled intersection: route lanes from its design
+      int lo, hi;
+      ix::okLanes(ixv, node, S.edge, nd, &lo, &hi);
+      ok = 0;
+      if (hi > lo) { for (int k = lo; k < hi && k < 32; ++k) ok |= 1u << k; ixEnd = node; }
+      else ok = alive;                   // movement not in the design: LPSim's default pass-through
+      break;
+    }
+    const int nOut = edgesData[nd].numLines;
+    const float Lout = edgesData[nd].length;
+    unsigned cont = 0;                   // lanes that continue into the next edge
+    for (int k = 0; k < S.nl && k < 32; ++k)
+      if (((alive >> k) & 1u) && lg::follow(G, S.edge, nd, k, nOut, Lout) >= 0) cont |= 1u << k;
+    if (!lg::hasLinks(G, S.edge)) {      // no lane links: LPSim's lanes for the exit
+      ushort lo = 0, hi = 0;
+      calculateLaneCarShouldBe(S.edge, nd, intersections, edgesData[S.edge].nextIntersMapped, S.nl, lo, hi);
+      if (hi > lo && hi <= S.nl) {
+        unsigned r = 0;
+        for (int k = lo; k < hi && k < 32; ++k) r |= 1u << k;
+        cont &= r;
+      }
+    }
+    if (cont == 0 || cont != alive) { ok = cont ? cont : alive; break; }   // a lane choice or lane drop: segment end
+    if (endRel >= rl::kLookahead || C.n >= rl::kMaxChain) { ok = alive; break; }
+    // a lane slot that already ended in the chain may not start again (a training segment has one
+    // span per lane, e.g. an acceleration lane followed by the next ramp's deceleration lane)
+    const int shiftN = S.shift + lg::shiftOf(G, S.edge, nd);
+    unsigned aliveSlots = 0, newSlots = 0;
+    for (int k = 0; k < S.nl; ++k) {
+      const int j = k - S.shift - rl::kLaneLo;
+      if (((alive >> k) & 1u) && j >= 0 && j < 32) aliveSlots |= 1u << j;
+    }
+    for (int k = 0; k < nOut; ++k) {
+      const int j = k - shiftN - rl::kLaneLo;
+      const float2 sp = lg::span(G, nd, k, Lout);
+      if (sp.y > sp.x && j >= 0 && j < 32) newSlots |= 1u << j;
+    }
+    if (newSlots & usedSlots & ~aliveSlots) { ok = alive; break; }
+    C.seg[C.n] = rl::Seg{nd, nOut, Lout, endRel, shiftN};
+    ++C.n; ++idx;
+    endRel += Lout;
+    usedSlots |= newSlots;
+  }
+  C.end = endRel;
+  C.okMask = ok;
+  // upstream edges on the path (followers within the information range), through uncontrolled nodes
+  float back = -pos;
+  int shiftBack = 0;
+  int down = (int)currentEdge_d;
+  for (uint j = v.indexPathCurr; j > v.indexPathInit && C.nBack < rl::kMaxBack && back > -200.0f; --j) {
+    const uint pe = indexPathVec[j - 1];
+    if (pe == END_OF_PATH) break;
+    const int pd = (int)laneMapper[pe];
+    if (ixv.nNodes > 0 && ixv.edgeNode[pd] >= 0) break;
+    shiftBack -= lg::shiftOf(G, pd, down);
+    back -= edgesData[pd].length;
+    C.back[C.nBack++] = rl::Seg{pd, (int)edgesData[pd].numLines, edgesData[pd].length, back, shiftBack};
+    down = pd;
+  }
+  return ixEnd;
+}
