+// Exit-lane room for path P: first occupied cell of its exit lane, and the vehicles committed to it.
+__device__ void ixExitRoom(const ix::View& V, const ix::Path& P, const uchar* laneMap, uint mapToReadShift,
+                           int* firstCell, int* heading) {
+  *firstCell = 1000;
+  for (int b = 0; b < 30; ++b) {
+    if (ldg_lane(laneMap, mapToReadShift + kMaxMapWidthM * (P.outEdge + P.exitLane) + b) != 0xFF) { *firstCell = b; break; }
+  }
+  *heading = 0;
+  const ix::Node& nd = V.nodes[P.node];
+  for (int i = 0; i < nd.nPaths; ++i) {
+    const int q = nd.pathStart + i;
+    if (V.paths[q].outEdge != P.outEdge || V.paths[q].exitLane != P.exitLane) continue;
+    const int cnt = min(V.occCount[q], ix::kOccCap);
+    for (int k = 0; k < cnt; ++k) *heading += (V.occ[q * ix::kOccCap + k].flags & (ix::kInBox | ix::kGranted)) ? 1 : 0;
+  }
+}
