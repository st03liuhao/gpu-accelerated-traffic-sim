+// Vehicle inside the box: IDM along its turning path behind same-path / diverging leaders and the
+// first vehicle of its exit lane, stopping at conflict zones held by others and busy crosswalks.
+__device__ void ixBoxStep(const ix::View& V, LC::B18TrafficVehicle& veh, int p, LC::B18EdgeData* edgesData,
+                          uchar* laneMap, uint mapToReadShift, uint mapToWriteShift, float now, float dt,
+                          const parameters& sp, float approachLen) {
+  const ix::Path& P = V.paths[veh.ixPath];
+  float s = veh.ixS, v = veh.v;
+  ix::countOverlap(V, veh.ixPath, s, p);
+  const float vmax = fminf(edgesData[P.outEdge].maxSpeedMperSec, ix::kTurnSpeed[P.mov]);
+  float gap, vl;
+  ix::boxLeader(V, veh.ixPath, s, p, &gap, &vl);
+  for (int b = 0; b < 40; ++b) {
+    const uint pos = mapToReadShift + kMaxMapWidthM * (P.outEdge + P.exitLane) + b;
+    const uchar c = ldg_lane(laneMap, pos);
+    if (c != 0xFF) {
+      const float g = (P.len - s) + b;
+      if (g < gap) { gap = g; vl = c / 3.0f; }
+      break;
+    }
+  }
+  if (veh.ixStaged) {                        // waiting at the staging point: released by a safe gap
+    int firstCell, heading;
+    ixExitRoom(V, P, laneMap, mapToReadShift, &firstCell, &heading);
+    const bool rel = ix::permission(V, veh.ixPath, s, v, ix::rank(V, veh.ixPath, true), veh.ixStopTime, veh.rlAggr, p, now,
+                       firstCell, heading, true);
+    if (rel) veh.ixStaged = 0;
+  }
+  const float wall = ix::boxWall(V, veh.ixPath, s, v, p, now, veh.ixStaged);
+  float g = gap, vlead = vl;
+  if (wall < g) { g = wall; vlead = 0.0f; }
+  float third = 0.0f;
+  if (g < 1e8f) {
+    const float sstar = sp.s_0 + fmaxf(0.0f, v * veh.T + v * (v - vlead) / (2.0f * sqrtf(veh.a * veh.b)));
+    third = powf(sstar / fmaxf(g, 0.1f), 2.0f);
+  }
+  const float acc = veh.a * (1.0f - powf(v / fmaxf(vmax, 1.0f), 4.0f) - third);
+  float vNew = fmaxf(0.0f, v + acc * dt);
+  if (g < 1e8f) vNew = fminf(vNew, fmaxf(0.0f, ix::krauss(v, g, vlead, dt)));
+  float move = 0.5f * (v + vNew) * dt;
+  if (wall < 1e8f) move = fminf(move, fmaxf(wall - 0.3f, 0.0f));
+  s += move;
+  veh.v = vNew;
+  veh.cum_v += vNew;
+  if (s < P.len) { veh.ixS = s; return; }
+  // leave the box onto the exit lane
+  const float x = s - P.len;
+  const ushort cell = (ushort)x;
+  const uint posW = mapToWriteShift + kMaxMapWidthM * (P.outEdge + ((int)(cell / kMaxMapWidthM)) *
+                    edgesData[P.outEdge].numLines + P.exitLane) + cell % kMaxMapWidthM;
+  if (!atomicCASUchar(&laneMap[posW], 0xFF, (uchar)(vNew * 3))) {   // exit cell taken: wait at the box edge
+    veh.ixS = P.len - 0.01f;
+    veh.v = 0.0f;
+    return;
+  }
+  veh.indexPathCurr++;
+  veh.numOfLaneInEdge = P.exitLane;
+  veh.posInLaneM = x;
+  veh.dist_traveled += approachLen;
+  veh.path_length_gpu++;
+  veh.LC_stateofLaneChanging = 0;
+  veh.LC_initOKLanes = 0xFF;
+  veh.LC_endOKLanes = 0xFF;
+  veh.lcFrom = veh.lcTo = P.exitLane;   // [lcrl-rl]
+  veh.lcProg = 0.0f;
+  veh.ixInBox = veh.ixGranted = veh.ixStopped = veh.ixStaged = 0;
+  veh.ixPath = -1;
+}
