+  for (auto& r : ix::readCsv(networkDir + "lane_links.csv")) {
+    if (r.size() < 3) continue;
+    const int a = edgeD(std::stoll(r[0])), b = edgeD(std::stoll(r[1]));
+    if (a < 0 || b < 0 || a >= numEdgesD || b >= numEdgesD) continue;
+    linkOf[a].push_back(make_int2(b, std::stoi(r[2])));
+  }
+  if (spanOf.empty() && linkOf.empty()) return;
+  std::vector<int> off(numEdgesD, -1), n(numEdgesD, 0), loff(numEdgesD, -1), ln(numEdgesD, 0);
+  std::vector<float2> spans;
+  std::vector<int2> links;
+  for (auto& kv : spanOf) { off[kv.first] = (int)spans.size(); n[kv.first] = (int)kv.second.size(); spans.insert(spans.end(), kv.second.begin(), kv.second.end()); }
+  for (auto& kv : linkOf) { loff[kv.first] = (int)links.size(); ln[kv.first] = (int)kv.second.size(); links.insert(links.end(), kv.second.begin(), kv.second.end()); }
+  if (spans.empty()) spans.push_back(make_float2(0.0f, 0.0f));
+  if (links.empty()) links.push_back(make_int2(-1, 0));
+  g_lg.nEdges = numEdgesD;
+  g_lg.spanOff = ix::upload(off); g_lg.spanN = ix::upload(n); g_lg.spans = ix::upload(spans);
+  g_lg.linkOff = ix::upload(loff); g_lg.linkN = ix::upload(ln); g_lg.links = ix::upload(links);
+  g_lg.stats = ix::upload(std::vector<unsigned long long>(lg::kNumStats, 0ull));
+  printf("[lg] lane spans on %zu edges, lane links from %zu edges\n", spanOf.size(), linkOf.size());
+}
+
+// [lcrl-ix] --------------------------------------------------------------- host entry points
+static std::vector<unsigned char> g_edgeFromIxHost;
+bool ixInitCUDA(const std::string& networkDir, const std::vector<uint>& edgeIdToLaneMapNum,
+                const std::map<uint, uint>& laneIdToLaneIdInGpu, int numEdgesD, float amax) {
+  ix::Host H;
+  auto edgeD = [&](long long uid) -> int {
+    if (uid < 0 || uid >= (long long)edgeIdToLaneMapNum.size()) return -1;
+    auto it = laneIdToLaneIdInGpu.find(edgeIdToLaneMapNum[uid]);
+    return it == laneIdToLaneIdInGpu.end() ? -1 : (int)it->second;
+  };
+  if (ngpus != 1 || !ix::load(networkDir, numEdgesD, edgeD, H)) return false;
+  g_ix = ix::makeView(H);
+  g_edgeFromIxHost.assign(numEdgesD, 0);   // [lcrl-rl] exit edges of controlled intersections
+  for (auto& L : H.legs) if (L.outEdge >= 0 && L.outEdge < numEdgesD) g_edgeFromIxHost[L.outEdge] = 1;
+  g_ix.debug = getenv("LPSIM_IX_DEBUG") != nullptr;
+  {                                        // edge_curves.csv: curve speed caps along curved edges
+    std::vector<int> off(numEdgesD, -1), cnt(numEdgesD, 0);
+    std::vector<float> caps;
+    float step = 10.0f;
+    for (auto& r : ix::readCsv(networkDir + "edge_curves.csv")) {
+      if (r.size() < 3) continue;
+      const int e = edgeD(std::stoll(r[0]));
+      if (e < 0 || e >= numEdgesD) continue;
+      step = std::stof(r[1]);
+      off[e] = (int)caps.size();
+      std::stringstream ss(r[2]);
+      std::string tok;
+      while (std::getline(ss, tok, ';')) caps.push_back(std::stof(tok));
+      cnt[e] = (int)caps.size() - off[e];
+    }
+    if (!caps.empty()) {
+      g_ix.curveOff = ix::upload(off); g_ix.curveN = ix::upload(cnt); g_ix.curveCaps = ix::upload(caps);
+      g_ix.curveStep = step;
+      g_ix.nEdges = numEdgesD;
+      printf("[ix] curve speed caps on %d edges\n", (int)std::count_if(off.begin(), off.end(), [](int o) { return o >= 0; }));
+    }
+  }
+  g_ix.amax = amax;
+  int bad = 0;
+  for (auto& P : H.paths) bad += (P.inEdge < 0 || P.outEdge < 0);
+  printf("[ix] %d controlled intersections, %d turning paths, %zu conflict entries (%d paths with unknown edges)\n",
+         g_ix.nNodes, g_ix.nPaths, H.conf.size(), bad);
+  return true;
+}
+
+void ixReportCUDA() {
+  if (g_lg.stats) {                      // [lcrl-lg]
+    unsigned long long st[lg::kNumStats];
+    cudaMemcpy(st, g_lg.stats, sizeof(st), cudaMemcpyDeviceToHost);
+    printf("[lg] node crossings %llu, from a lane that does not continue %llu, vehicle-steps stopped at a lane end %llu\n",
+           st[lg::kCrossings], st[lg::kForced], st[lg::kStoppedAtEnd]);
+  }
+  if (g_ix.nNodes == 0) return;
+  unsigned long long st[ix::kNumStats];
+  cudaMemcpy(st, g_ix.stats, sizeof(st), cudaMemcpyDeviceToHost);
+  printf("[ix] crossed %llu, missed movement %llu (%.2f%%), stop-line violations %llu, conflict-zone overlaps %llu, "
+         "list overflows near %llu far %llu\n",
+         st[ix::kCrossed], st[ix::kMissed], st[ix::kCrossed] ? 100.0 * st[ix::kMissed] / st[ix::kCrossed] : 0.0,
+         st[ix::kViolations], st[ix::kConflictOverlap] / 2, st[ix::kOccOverflow], st[ix::kOccFarOverflow]);
+}
+
+
+// [lcrl-rl] --------------------------------------------------------------- RL lane changing
+static bool g_rlRequested = false;
+void rlSetEnabled(bool on) { g_rlRequested = on; }
+
+void rlInitCUDA() {
+  if (!g_rlRequested || ngpus != 1) return;
+  g_rl.enabled = 1;
+  gpuErrchk(cudaMalloc((void**)&g_rl.intentMap, laneMap_d_size[0]));
+  gpuErrchk(cudaMemset(g_rl.intentMap, 0, laneMap_d_size[0]));
+  std::vector<unsigned char> fromIx = g_edgeFromIxHost;
+  fromIx.resize(std::max<size_t>(fromIx.size(), edgesData_d_size[0]), 0);
+  unsigned char* d = nullptr;
+  gpuErrchk(cudaMalloc((void**)&d, fromIx.size()));
+  gpuErrchk(cudaMemcpy(d, fromIx.data(), fromIx.size(), cudaMemcpyHostToDevice));
+  g_rl.edgeFromIx = d;
+  gpuErrchk(cudaMalloc((void**)&g_rl.stats, 4 * sizeof(unsigned long long)));
+  gpuErrchk(cudaMemset(g_rl.stats, 0, 4 * sizeof(unsigned long long)));
+  if (getenv("LPSIM_RL_DUMP")) {
+    g_rl.dbgCap = 200000;
+    gpuErrchk(cudaMalloc((void**)&g_rl.dbgObs, (size_t)g_rl.dbgCap * (LC_OBS_DIM + 4) * sizeof(float)));
+    gpuErrchk(cudaMalloc((void**)&g_rl.dbgCount, sizeof(int)));
+    gpuErrchk(cudaMemset(g_rl.dbgCount, 0, sizeof(int)));
+  }
+  g_rl.rule = getenv("LPSIM_LC_RULE") && atoi(getenv("LPSIM_LC_RULE")) != 0;
+  printf("[rl] %s enabled (%d observation features)\n",
+         g_rl.rule ? "rule baseline on the RL lane-change path" : "RL lane-change policy", LC_OBS_DIM);
+}
+
+void rlReportCUDA() {
+  if (!g_rl.enabled) return;
+  unsigned long long st[4];
+  cudaMemcpy(st, g_rl.stats, sizeof(st), cudaMemcpyDeviceToHost);
+  printf("[rl] lane changes started %llu, aborted %llu (on edges < 120 m: %llu, approaching controlled intersections: %llu)\n",
+         st[0], st[1], st[2], st[3]);
+  if (g_rl.dbgCap > 0) {                       // rl_obs_dump.csv: obs..., lat, lon, aborting, at_ix
+    int n = 0;
+    cudaMemcpy(&n, g_rl.dbgCount, sizeof(int), cudaMemcpyDeviceToHost);
+    n = std::min(n, g_rl.dbgCap);
+    std::vector<float> buf((size_t)n * (LC_OBS_DIM + 4));
+    cudaMemcpy(buf.data(), g_rl.dbgObs, buf.size() * sizeof(float), cudaMemcpyDeviceToHost);
+    FILE* f = fopen("rl_obs_dump.csv", "w");
+    for (int i = 0; i < n; ++i) {
+      for (int j = 0; j < LC_OBS_DIM + 4; ++j) fprintf(f, j ? ",%g" : "%g", buf[(size_t)i * (LC_OBS_DIM + 4) + j]);
+      fprintf(f, "\n");
+    }
+    fclose(f);
+    printf("[rl] wrote %d observation rows to rl_obs_dump.csv\n", n);
+  }
+}
