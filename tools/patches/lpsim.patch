+// Lane geometry along LPSim edges: lanes that start or end part-way along an edge (turn bays,
+// acceleration and deceleration lanes, lane drops), and lane links at nodes without
+// intersection control (which lane of the next edge each lane continues into).
+//
+// Loaded from two optional files next to the network (written by tools/generate_network.py
+// --lane-spans, or by the test-network tools):
+//   edge_lanes.csv  uniqueid, lane, start_m, end_m     lane 0 = leftmost; edges not listed have
+//                                                      every lane over the whole edge
+//   lane_links.csv  in_edge, out_edge, shift           lane k of in_edge continues as lane k + shift
+//                                                      of out_edge; an in_edge with any row uses only
+//                                                      its rows (out edges without a row: no lane
+//                                                      continues, e.g. a U-turn)
+// Without the files LPSim behaves as before: full-length lanes, same lane index across a node
+// (clamped to the next edge's lanes).
+#pragma once
+
+namespace lg {
+
+struct View {
+  int nEdges = 0;
+  const int* spanOff = nullptr;    // [nEdges] -1: every lane spans the whole edge
+  const int* spanN = nullptr;      // [nEdges] lanes listed (lanes beyond: whole edge)
+  const float2* spans = nullptr;   // (start_m, end_m)
+  const int* linkOff = nullptr;    // [nEdges] -1: no lane links for this in-edge
+  const int* linkN = nullptr;
+  const int2* links = nullptr;     // (out edge_d, lane shift)
+  unsigned long long* stats = nullptr;   // kForced, kStoppedAtEnd, kCrossings
+  // Vehicle lengths, same layout as the lane map: the cell holding a vehicle's front bumper
+  // also holds its length (m). Written wherever the lane map is written, read only where the
+  // lane map shows a vehicle, so it is never cleared.
+  unsigned char* lenMap = nullptr;
+};
+enum Stat { kForced = 0, kStoppedAtEnd = 1, kCrossings = 2, kNumStats = 3 };
+constexpr float kDefaultLen = 5.0f;
+
+// length of the vehicle whose front is in lane-map cell idx
+__device__ __forceinline__ float lenAt(const View& V, unsigned int idx) {
+  return V.lenMap ? (float)V.lenMap[idx] : kDefaultLen;
+}
+__device__ __forceinline__ void putLen(const View& V, unsigned int idx, unsigned char len) {
+  if (V.lenMap) V.lenMap[idx] = len;
+}
+
+// (start, end) of lane k on edge e of length L
+__device__ __forceinline__ float2 span(const View& V, int e, int k, float L) {
+  if (V.spanOff == nullptr || e < 0 || e >= V.nEdges) return make_float2(0.0f, L);
+  const int o = V.spanOff[e];
+  if (o < 0 || k < 0 || k >= V.spanN[e]) return make_float2(0.0f, L);
+  const float2 s = V.spans[o + k];
+  return make_float2(fmaxf(s.x, 0.0f), fminf(s.y, L));
+}
+
+__device__ __forceinline__ bool existsAt(const View& V, int e, int k, int nl, float x, float L) {
+  if (k < 0 || k >= nl) return false;
+  const float2 s = span(V, e, k, L);
+  return s.x <= x && x <= s.y;
+}
+
+// lane end inside the edge (a dropped / acceleration lane), or 1e9 when the lane reaches the edge end
+__device__ __forceinline__ float endInside(const View& V, int e, int k, float L) {
+  const float2 s = span(V, e, k, L);
+  return s.y < L - 1.0f ? s.y : 1e9f;
+}
+
+// rightmost lane that exists at x (spawning), or -1
+__device__ __forceinline__ int rightmostAt(const View& V, int e, int nl, float x, float L) {
+  for (int k = nl - 1; k >= 0; --k) if (existsAt(V, e, k, nl, x, L)) return k;
+  return -1;
+}
+
+__device__ __forceinline__ bool hasLinks(const View& V, int in) {
+  return V.linkOff != nullptr && in >= 0 && in < V.nEdges && V.linkOff[in] >= 0;
+}
+
+// lane of `out` that lane k of `in` continues into, or -1 when it does not continue
+__device__ __forceinline__ int follow(const View& V, int in, int out, int k, int nOut, float Lout) {
+  int o = k;
+  if (hasLinks(V, in)) {
+    o = -1 << 20;
+    const int a = V.linkOff[in];
+    for (int i = 0; i < V.linkN[in]; ++i)
+      if (V.links[a + i].x == out) { o = k + V.links[a + i].y; break; }
+  }
+  return existsAt(V, out, o, nOut, 0.0f, Lout) ? o : -1;
+}
+
+// lane to put a vehicle in when it crosses into `out` (always a lane that exists at the start)
+__device__ __forceinline__ int transferLane(const View& V, int in, int out, int k, int nOut, float Lout) {
+  const int f = follow(V, in, out, k, nOut, Lout);
+  if (f >= 0) return f;
+  int o = k;                                   // no continuation: the nearest lane that exists
+  if (hasLinks(V, in)) {
+    const int a = V.linkOff[in];
+    for (int i = 0; i < V.linkN[in]; ++i) if (V.links[a + i].x == out) { o = k + V.links[a + i].y; break; }
+  }
+  o = max(0, min(o, nOut - 1));
+  for (int d = 0; d < nOut; ++d) {
+    if (existsAt(V, out, o - d, nOut, 0.0f, Lout)) return o - d;
+    if (existsAt(V, out, o + d, nOut, 0.0f, Lout)) return o + d;
+  }
+  return o;
+}
+
+// lane shift from `in` to `out` (0 without links)
+__device__ __forceinline__ int shiftOf(const View& V, int in, int out) {
+  if (!hasLinks(V, in)) return 0;
+  const int a = V.linkOff[in];
+  for (int i = 0; i < V.linkN[in]; ++i) if (V.links[a + i].x == out) return V.links[a + i].y;
+  return 0;
+}
+
+}  // namespace lg
diff --git a/src/simulator/lc_policy.cuh b/src/simulator/lc_policy.cuh
new file mode 100644
index 0000000..255b540
--- /dev/null
+++ b/src/simulator/lc_policy.cuh
@@ -0,0 +1,54 @@
+// Lane-changing policy inference for LPSim's per-vehicle CUDA kernel.
+//
+// Include this header in cuda_traffic_sim.cu after generating lc_policy_weights.h with
+//   python -m lcrl.export_cuda --policy runs/<run>/policy.pt --out cuda/lc_policy_weights.h
+//
+// One thread evaluates one vehicle: ~8.5k multiply-adds, weights in __constant__ memory
+// (every lane of a warp reads the same weight at the same time -> broadcast).
+#pragma once
+#include "lc_policy_weights.h"
+
+// Lateral actions
+#define LC_LAT_KEEP 0   // keep lane / continue the ongoing change
+#define LC_LAT_LEFT 1   // start (or continue) a change to lane-1; aborts an ongoing right change
+#define LC_LAT_RIGHT 2  // start (or continue) a change to lane+1; aborts an ongoing left change
+
+// Acceleration offset (m/s^2) added to the IDM acceleration for each longitudinal action.
+__device__ __forceinline__ float lcLonDelta(int lon) {
+  const float d[LC_NUM_LON] = LC_LON_DELTAS;
+  return d[lon];
+}
+
+// obs:     LC_OBS_DIM features, built exactly as lcrl/env.py:LaneChangeEnv.observe()
+// latMask: lateral actions allowed by the safety shield (LC_LAT_KEEP must be allowed)
+// lat/lon: greedy actions
+__device__ inline void lcPolicyAct(const float* __restrict__ obs, const bool latMask[LC_NUM_LAT],
+                                   int& lat, int& lon) {
+  float h1[LC_HIDDEN], h2[LC_HIDDEN];
+#pragma unroll 4
+  for (int j = 0; j < LC_HIDDEN; ++j) {
+    float s = lc_b1[j];
+    for (int i = 0; i < LC_OBS_DIM; ++i) s += lc_W1[j * LC_OBS_DIM + i] * obs[i];
+    h1[j] = tanhf(s);
+  }
+#pragma unroll 4
+  for (int j = 0; j < LC_HIDDEN; ++j) {
+    float s = lc_b2[j];
+    for (int i = 0; i < LC_HIDDEN; ++i) s += lc_W2[j * LC_HIDDEN + i] * h1[i];
+    h2[j] = tanhf(s);
+  }
+  float best = -1e30f;
+  lat = LC_LAT_KEEP;
+  lon = 0;
+  for (int j = 0; j < LC_NUM_LAT + LC_NUM_LON; ++j) {
+    float s = lc_b3[j];
+    for (int i = 0; i < LC_HIDDEN; ++i) s += lc_W3[j * LC_HIDDEN + i] * h2[i];
+    if (j < LC_NUM_LAT) {
+      if (latMask[j] && s > best) { best = s; lat = j; }
+      if (j == LC_NUM_LAT - 1) best = -1e30f;
+    } else if (s > best) {
+      best = s;
+      lon = j - LC_NUM_LAT;
+    }
+  }
+}
