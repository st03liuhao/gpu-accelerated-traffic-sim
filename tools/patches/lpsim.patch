+void ixReportCUDA() {
+  if (g_ix.nNodes == 0) return;
+  unsigned long long st[ix::kNumStats];
+  cudaMemcpy(st, g_ix.stats, sizeof(st), cudaMemcpyDeviceToHost);
+  printf("[ix] crossed %llu, missed movement %llu (%.2f%%), stop-line violations %llu, conflict-zone overlaps %llu, "
+         "list overflows near %llu far %llu\n",
+         st[ix::kCrossed], st[ix::kMissed], st[ix::kCrossed] ? 100.0 * st[ix::kMissed] / st[ix::kCrossed] : 0.0,
+         st[ix::kViolations], st[ix::kConflictOverlap] / 2, st[ix::kOccOverflow], st[ix::kOccFarOverflow]);
+}
