+// [lcrl-rl] write the turn indicator, and the second lane while a lane change is in progress
+__device__ void rlMark(const rl::View& R, uchar* laneMap, const LC::B18TrafficVehicle& v, uint edge, int numLines,
+                       ushort cell, uint shift, uchar vIn, int dir, float urg) {
+  const uchar in = rl::encodeIntent(dir, urg);
+  R.intentMap[rl::cellIdx(shift, edge, v.numOfLaneInEdge, cell, numLines)] = in;
+  if (v.lcFrom != v.lcTo) {
+    const int other = v.numOfLaneInEdge == v.lcTo ? v.lcFrom : v.lcTo;
+    const uint idx = rl::cellIdx(shift, edge, other, cell, numLines);
+    if (atomicCASUchar(&laneMap[idx], 0xFF, vIn)) R.intentMap[idx] = in;
+  }
+}
