+// Every vehicle in, committed to, or within kDecideRange of an intersection lists itself on its path;
+// approaching vehicles 80-250 m out go on the path's far list (gap acceptance only).
+__global__ void kernel_ixPublish(ix::View V, int numPeople, float now, LC::B18TrafficVehicle* veh,
+                                 const uint* indexPathVec, const uint* laneMapper, const LC::B18EdgeData* edgesData,
+                                 const uchar* laneMap, uint mapToReadShift) {
+  int p = blockIdx.x * blockDim.x + threadIdx.x;
+  if (p >= numPeople) return;
+  const LC::B18TrafficVehicle& t = veh[p];
+  if (t.active != 1 || t.time_departure > now) return;
+  if (t.ixInBox) {
+    ix::publish(V, t.ixPath, t.ixS, t.v, t.v, t.ixStaged ? ix::rank(V, t.ixPath, true) : 3.0f, t.ixStopTime, p,
+                ix::kInBox | (t.ixStaged ? ix::kStaged : 0), (float)t.vlen);
+    return;
+  }
+  const uint cur = indexPathVec[t.indexPathCurr];
+  const uint nxt = indexPathVec[t.indexPathCurr + 1];
+  if (cur == END_OF_PATH || nxt == END_OF_PATH) return;
+  const uint e = laneMapper[cur], ne = laneMapper[nxt];
+  const int node = V.edgeNode[e];
+  if (node < 0) return;
+  const float L = edgesData[e].length, dist = L - t.posInLaneM;
+  if (dist > ix::kGapRange) return;
+  bool exact;
+  const int path = t.ixGranted ? t.ixPath : ix::findPath(V, node, e, t.numOfLaneInEdge, ne, &exact);
+  if (path < 0) return;
+  const float vmax = fmaxf(t.v, t.rlVdesFactor * edgesData[e].maxSpeedMperSec);
+  if (dist > ix::kDecideRange) {
+    if (!t.ixGranted) ix::publishFar(V, path, -dist, t.v, vmax, ix::rank(V, path, t.ixStopped), p, (float)t.vlen);
+    return;
+  }
+  bool head = true;
+  for (ushort b = (ushort)t.posInLaneM + 1; b < (ushort)ceilf(L) && head; ++b) {
+    const uint pos = mapToReadShift + kMaxMapWidthM * (e + ((int)(b / kMaxMapWidthM)) * edgesData[e].numLines +
+                     t.numOfLaneInEdge) + b % kMaxMapWidthM;
+    if (ldg_lane(laneMap, pos) != 0xFF) head = false;
+  }
+  const int flags = (t.ixGranted ? ix::kGranted : 0) | (head ? ix::kHead : 0) | (t.ixStopped ? ix::kStopped : 0) |
+                    (t.ixStaged ? ix::kStaged : 0);
+  ix::publish(V, path, -dist, t.v, vmax, ix::rank(V, path, t.ixStopped), t.ixStopTime, p, flags, (float)t.vlen);
+}
