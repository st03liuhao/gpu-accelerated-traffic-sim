+// [lcrl-rl] write the turn indicator, and the second lane while a lane change is in progress
+__device__ void rlMark(const rl::View& R, uchar* laneMap, const LC::B18TrafficVehicle& v, uint edge, int numLines,
+                       ushort cell, uint shift, uchar vIn, int dir, float urg) {
+  const uchar in = rl::encodeIntent(dir, urg);
+  R.intentMap[rl::cellIdx(shift, edge, v.numOfLaneInEdge, cell, numLines)] = in;
+  if (v.lcFrom != v.lcTo) {
+    const int other = v.numOfLaneInEdge == v.lcTo ? v.lcFrom : v.lcTo;
+    const uint idx = rl::cellIdx(shift, edge, other, cell, numLines);
+    if (atomicCASUchar(&laneMap[idx], 0xFF, vIn)) { R.intentMap[idx] = in; if (R.lenMap) R.lenMap[idx] = v.vlen; }
+  }
+}
+
+// [lcrl-lg] A vehicle whose move was undone (its target cell was taken) stays where it was. LPSim
+// returned without writing it into the lane map, so for that step its followers did not see it and
+// drove into it; vehicles then piled up in one cell and the overlap kept them stopped.
+__device__ void lgStayVisible(const rl::View& R, uchar* laneMap, const LC::B18TrafficVehicle& v, uint edge,
+                              int numLines, uint shift, int dir, float urg) {
+  const ushort cell = (ushort)v.posInLaneM;
+  const uchar vIn = (uchar)(fmaxf(v.v, 0.0f) * 3.0f);
+  const uint idx = rl::cellIdx(shift, edge, v.numOfLaneInEdge, cell, numLines);
+  if (atomicCASUchar(&laneMap[idx], 0xFF, vIn) && R.lenMap) R.lenMap[idx] = v.vlen;
+  if (R.enabled) rlMark(R, laneMap, v, edge, numLines, cell, shift, vIn, dir, urg);
+}
+
+// [lcrl-lg] LPSim's rule never changes lanes below 3 m/s. A vehicle stopped where its lane ends
+// moves into the nearest lane that goes on, once that lane is free from s_0 ahead to
+// s_0 + 1.5 s of the follower's speed behind.
+__device__ void lgMergeStopped(const lg::View& G, LC::B18TrafficVehicle& v, const uchar* laneMap, uint shift,
+                               uint edge, int nl, float len, float s0) {   // bumper gaps: s0 to both neighbours
+  const float le = lg::endInside(G, edge, v.numOfLaneInEdge, len);
+  if (le > 1e8f || le - v.posInLaneM > 30.0f) return;
+  const int c0 = v.numOfLaneInEdge, b0 = (int)v.posInLaneM;
+  for (int k : {c0 - 1, c0 + 1}) {
+    if (!lg::existsAt(G, edge, k, nl, v.posInLaneM, len) || lg::span(G, edge, k, len).y <= le + 1.0f) continue;
+    bool free = true;
+    for (int b = max(0, b0 - 60); b <= min((int)ceilf(len) - 1, b0 + (int)ceilf(s0) + rl::kTruckLen) && free; ++b) {
+      const uint idx = rl::cellIdx(shift, edge, k, b, nl);
+      const uchar c = laneMap[idx];
+      if (c == 0xFF) continue;
+      free = b > b0 ? (b - b0) - lg::lenAt(G, idx) >= s0 : (b0 - v.vlen - b) >= s0 + 1.5f * (c / 3.0f);
+    }
+    if (free) { v.numOfLaneInEdge = k; v.lcFrom = v.lcTo = k; return; }
+  }
+}
