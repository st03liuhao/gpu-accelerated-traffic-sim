+// Full-intersection control for LPSim (movement-based signal phases, all-way / two-way stop,
+// yield, pedestrian crossings, turning paths and conflict zones inside the box).
+//
+// Specification: docs/INTERSECTIONS.md of the RL lane-changing project; designs are produced
+// by tools/lpsim_intersections.py (ix_*.csv next to the network). This file is included by
+// cuda_traffic_sim.cu only. Single-GPU runs only (NUM_GPUS=1).
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace ix {
+
+enum Ctrl { kSignal = 1, kAwsc = 2, kTwsc = 3, kYield = 4 };
+enum SigState { kRed = 0, kPerm = 1, kGreen = 2, kAmber = 3 };
+enum ConfKind { kCross = 1, kMerge = 2, kDiverge = 3 };
+enum Mov { kLeft = 0, kThrough = 1, kRight = 2 };
+enum OccFlag { kInBox = 1, kGranted = 2, kHead = 4, kStopped = 8, kStaged = 16 };
+
+constexpr int kOccCap = 16;             // vehicles listed per path per step (near list)
+constexpr int kOccFarCap = 16;          // approaching vehicles 80-250 m out, per path (far list)
+constexpr float kVehLen = 5.0f;         // vehicle length for conflict-zone clearance (m)
+constexpr float kDecideRange = 80.0f;   // same-rank approaching vehicles considered for entry order (m)
+constexpr float kGapRange = 250.0f;     // higher-rank vehicles considered for gap acceptance (m)
+constexpr float kPetMin = 1.0f;         // post-encroachment margin after we clear
+__constant__ float kCritGap[3] = {4.0f, 5.5f, 5.0f};   // critical gap: left, through, right (s; + up to 1 s if cautious)
+constexpr float kAmax = 1.5f;           // acceleration used in time-to-reach estimates
+constexpr float kCrossFrom = 0.5f, kCrossTo = 4.5f;   // crosswalk span from each path end
+__constant__ float kTurnSpeed[3] = {9.0f, 99.0f, 6.0f};
+
+struct Node { int ctrl, nLegs, legStart, pathStart, nPaths, phaseStart, nPhase, stateStart, rtor; float cycle, offset; };
+struct Leg { int inEdge, outEdge, major; float pedRate, crossTime; };
+struct Path { int node, leg, lane, mov, exitLeg, exitLane, inEdge, outEdge, confStart, nConf; float len;
+              float sWait; int nStage; };   // staging point / places of a permitted turn (-1 / 0: none)
+struct Conf { int q, kind; float pIn, pOut, qIn, qOut; };
+struct Occ { float s, v, vmax, rank, stopTime; int veh, flags; };   // vmax: max(v, desired speed)
+
+struct View {                           // passed by value to kernels
+  int nNodes = 0, nPaths = 0, nEdges = 0, debug = 0;
+  float amax = 1.5f;                    // acceleration used in time-to-reach estimates
+  const Node* nodes = nullptr;
+  const Leg* legs = nullptr;
+  const Path* paths = nullptr;
+  const Conf* conf = nullptr;
+  const float* phaseDur = nullptr;
+  const int* phaseWalk = nullptr;
+  const unsigned char* phaseState = nullptr;
+  const int* edgeNode = nullptr;        // edge_d -> node index entered by this edge, or -1
+  unsigned char* pathState = nullptr;   // per path, written by kernel_ixControl
+  float* pathTts = nullptr;             // seconds until the path's signal state changes
+  Occ* occ = nullptr;                   // per path: kOccCap entries
+  int* occCount = nullptr;
+  Occ* occFar = nullptr;                // per path: kOccFarCap approaching vehicles 80-250 m out
+  int* occFarCount = nullptr;
+  float* pedBusyUntil = nullptr;        // per leg
+  float* pedWait = nullptr;
+  unsigned long long* stats = nullptr;  // see Stat
+  const int* curveOff = nullptr;        // per edge_d: first curve-cap sample, or -1 (edge_curves.csv)
+  const int* curveN = nullptr;
+  const float* curveCaps = nullptr;     // m/s every curveStep metres from the edge start
+  float curveStep = 10.0f;
+};
+enum Stat { kCrossed = 0, kMissed = 1, kViolations = 2, kConflictOverlap = 3, kOccOverflow = 4, kOccFarOverflow = 5, kNumStats = 8 };
+
+// ---------------------------------------------------------------- device helpers
+__device__ __forceinline__ float tReach(float v, float d, float a) {
+  d = fmaxf(d, 0.0f);
+  return (-v + sqrtf(v * v + 2.0f * a * d)) / a;
+}
+
+// time to cover d metres from speed v accelerating at a up to vmax, then cruising
+__device__ __forceinline__ float tReachCapped(float v, float d, float vmax, float a) {
+  d = fmaxf(d, 0.0f);
+  vmax = fmaxf(vmax, v + 1e-3f);
+  const float d1 = (vmax * vmax - v * v) / (2.0f * a);
+  if (d <= d1) return (-v + sqrtf(v * v + 2.0f * a * d)) / a;
+  return (vmax - v) / a + (d - d1) / vmax;
+}
+
+__device__ __forceinline__ float krauss(float v, float gap, float vl, float dt) {
+  const float b = 4.5f;
+  return vl + (gap - 0.5f - vl * dt) / ((v + vl) / (2.0f * b) + dt);
+}
+
+// curve speed cap at position pos (m) on edge e
+__device__ __forceinline__ float curveCap(const View& V, int e, float pos) {
+  if (V.curveOff == nullptr || e < 0 || e >= V.nEdges) return 1e9f;
+  const int off = V.curveOff[e];
+  if (off < 0) return 1e9f;
+  const int i = min((int)(fmaxf(pos, 0.0f) / V.curveStep) + 1, V.curveN[e] - 1);
+  return V.curveCaps[off + i];
+}
+
+// path from (in edge, lane) towards out edge; exact = the lane serves that exit
+__device__ int findPath(const View& V, int node, int inEdge, int lane, int outEdge, bool* exact) {
+  const Node& n = V.nodes[node];
+  int best = -1, bestD = 1 << 20;
+  for (int i = 0; i < n.nPaths; ++i) {
+    const Path& P = V.paths[n.pathStart + i];
+    if (P.inEdge != inEdge || P.outEdge != outEdge) continue;
+    int d = abs(P.lane - lane);
+    if (d < bestD) { bestD = d; best = n.pathStart + i; }
+  }
+  *exact = bestD == 0;
+  return best;
+}
+
+// lanes [lo, hi) of inEdge that serve outEdge at this node
+__device__ void okLanes(const View& V, int node, int inEdge, int outEdge, int* lo, int* hi) {
+  const Node& n = V.nodes[node];
+  *lo = 1 << 20; *hi = -1;
+  for (int i = 0; i < n.nPaths; ++i) {
+    const Path& P = V.paths[n.pathStart + i];
+    if (P.inEdge == inEdge && P.outEdge == outEdge) { *lo = min(*lo, P.lane); *hi = max(*hi, P.lane + 1); }
+  }
+}
+
+// right-of-way rank of a path (section 2 of the spec)
+__device__ float rank(const View& V, int path, bool stopped) {
+  const Path& P = V.paths[path];
+  const Node& n = V.nodes[P.node];
+  const bool major = V.legs[n.legStart + P.leg].major;
+  const float minorRank = 1.0f;                 // minor movements take turns (FCFS by stop time)
+  const float majorRank = P.mov == kLeft ? 1.5f : 2.0f;
+  switch (n.ctrl) {
+    case kSignal: {
+      const int st = V.pathState[path];
+      if (st == kGreen) return 2.0f;
+      if (st == kPerm) return 1.0f;
+      if (st == kRed && n.rtor && P.mov == kRight && stopped) return 0.5f;
+      return 0.0f;
+    }
+    case kAwsc: return stopped ? 1.0f : 0.0f;
+    case kTwsc: return major ? majorRank : (stopped ? minorRank : 0.0f);
+    default: return major ? majorRank : minorRank;
+  }
+}
+
+__device__ __forceinline__ bool pedBusy(const View& V, int node, int leg, float now) {
+  return V.pedBusyUntil[V.nodes[node].legStart + leg] > now;
+}
+
+// Entry permission (section 3 of the spec) for the head vehicle `self` on path p, or the
+// release of a staged vehicle (holding: waiting inside the box at the staging point).
+//   s: position along the path (negative = metres before the stop line), r: own rank,
+//   aggr: aggressiveness (sets the safety gap)
+__device__ bool permission(const View& V, int p, float s, float v, float r, float stopTime,
+                           float aggr, int self, float now, int exitFirstCell, int nHeadingExit, bool holding) {
+  if (r <= 0.0f && !holding) return false;
+  const Path& P = V.paths[p];
+  const Node& n = V.nodes[P.node];
+  if (pedBusy(V, P.node, P.exitLeg, now) || (!holding && pedBusy(V, P.node, P.leg, now))) return false;
+  // exit lane must have room for us plus everyone else already heading there
+  if (exitFirstCell - (nHeadingExit - (holding ? 1 : 0)) * (kVehLen + 1.38f) < kVehLen + 1.38f) return false;
+  const bool clearOnly = holding && r <= 0.0f;     // phase over: clear as soon as the box allows
+  const float h = 1.0f + (1.0f - aggr);
+  const float cautious = 1.0f - aggr;
+  for (int c = 0; c < P.nConf; ++c) {
+    const Conf& C = V.conf[P.confStart + c];
+    if (C.kind == kDiverge) continue;
+    const float tClear = tReach(v, C.pOut - s + kVehLen, V.amax);
+    const float etaSelf = tReach(v, C.pIn - s, V.amax);
+    // gap acceptance against higher-rank traffic: critical gap of our movement, and a
+    // post-encroachment margin after we have cleared the zone
+    const float needGap = fmaxf(kCritGap[P.mov] + cautious, tClear + kPetMin);
+    const int cnt = min(V.occCount[C.q], kOccCap);
+    for (int k = 0; k < cnt; ++k) {
+      const Occ& o = V.occ[C.q * kOccCap + k];
+      if (o.veh == self) continue;
+      const bool cleared = o.s - kVehLen > C.qOut;
+      if (cleared) continue;
+      const bool inside = o.s >= C.qIn;
+      const float eta = tReach(o.v, C.qIn - o.s, V.amax);
+      if (o.flags & (kInBox | kGranted)) {                       // A: already committed
+        // a staged vehicle waiting for its gap blocks only zones it occupies; once its own phase
+        // has ended it clears first (but never blocks another staged vehicle's release)
+        const bool waiting = (o.flags & kStaged) && !(o.rank <= 0.0f && !holding);
+        // a vehicle already inside a zone (a staged turner) has priority to clear it
+        const bool selfInside = s >= C.pIn;
+        if (inside || (!waiting && !selfInside && eta < tClear + h)) return false;
+        continue;
+      }
+      if (clearOnly) continue;
+      if (o.rank > r + 1e-3f) {                                   // B: higher priority approaching
+        if (-o.s <= kGapRange && tReachCapped(o.v, C.qIn - o.s, o.vmax, V.amax) < needGap) return false;
+        continue;
+      }
+      if (-o.s > kDecideRange) continue;
+      if (fabsf(o.rank - r) <= 1e-3f) {                    // C: same rank
+        if (n.ctrl == kAwsc || n.ctrl == kTwsc) {
+          if ((o.flags & kHead) && (o.flags & kStopped) &&
+              (o.stopTime < stopTime - 1e-3f || (fabsf(o.stopTime - stopTime) <= 1e-3f && o.veh < self))) return false;
+        } else if (eta < etaSelf && eta < tClear + h) {
+          return false;
+        }
+      }
+    }
+    const int cntFar = clearOnly ? 0 : min(V.occFarCount[C.q], kOccFarCap);   // B: higher priority, 80-250 m out
+    for (int k = 0; k < cntFar; ++k) {
+      const Occ& o = V.occFar[C.q * kOccFarCap + k];
+      if (o.veh == self || o.rank <= r + 1e-3f) continue;
+      if (tReachCapped(o.v, C.qIn - o.s, o.vmax, V.amax) < needGap) return false;
+    }
+  }
+  return true;
+}
+
+// May the head vehicle `self` pull into the box and wait at its path's staging point? The
+// movement must be permitted now, a staging place free, and nothing committed may be crossing
+// the zones before the staging point.
+__device__ bool stageOk(const View& V, int p, float s, float v, float r, int self, float now,
+                        int exitFirstCell, int nHeadingExit, float aggr) {
+  const Path& P = V.paths[p];
+  if (P.nStage <= 0 || P.sWait <= 0.0f || r <= 0.0f || V.pathState[p] != kPerm) return false;
+  if (pedBusy(V, P.node, P.leg, now)) return false;
+  if (exitFirstCell - nHeadingExit * (kVehLen + 1.38f) < kVehLen + 1.38f) return false;
+  int waiting = 0;
+  const int cntP = min(V.occCount[p], kOccCap);
+  for (int k = 0; k < cntP; ++k) waiting += (V.occ[p * kOccCap + k].flags & kStaged) ? 1 : 0;
+  if (waiting >= P.nStage) return false;
+  const float h = 1.0f + (1.0f - aggr);
+  for (int c = 0; c < P.nConf; ++c) {
+    const Conf& C = V.conf[P.confStart + c];
+    if (C.kind == kDiverge || C.pIn >= P.sWait) continue;
+    const float tClear = tReach(v, C.pOut - s + kVehLen, V.amax);
+    const int cnt = min(V.occCount[C.q], kOccCap);
+    for (int k = 0; k < cnt; ++k) {
+      const Occ& o = V.occ[C.q * kOccCap + k];
+      if (o.veh == self || !(o.flags & (kInBox | kGranted))) continue;
+      if (o.s - kVehLen > C.qOut) continue;
+      const bool waiting = (o.flags & kStaged) && o.rank > 0.0f;
+      if (o.s >= C.qIn || (!waiting && tReach(o.v, C.qIn - o.s, V.amax) < tClear + h)) return false;
+    }
+  }
+  return true;
+}
+
+// Nearest wall (m along own path; s < 0 before the stop line) for a vehicle in or committed to
+// the box: conflict zones held by others, occupied crosswalks (sections 4-5 of the spec), and
+// the staging point while the vehicle waits there.
+__device__ float boxWall(const View& V, int p, float s, float v, int self, float now, bool holding) {
+  const Path& P = V.paths[p];
+  float wall = 1e9f;
+  const float etaSelfBase = v;
+  for (int c = 0; c < P.nConf; ++c) {
+    const Conf& C = V.conf[P.confStart + c];
+    if (C.kind == kDiverge || s >= C.pIn - 0.5f) continue;
+    const float etaSelf = tReach(etaSelfBase, C.pIn - s, V.amax);
+    const int cnt = min(V.occCount[C.q], kOccCap);
+    for (int k = 0; k < cnt; ++k) {
+      const Occ& o = V.occ[C.q * kOccCap + k];
+      if (o.veh == self || !(o.flags & (kInBox | kGranted))) continue;
+      const bool cleared = o.s - kVehLen > C.qOut;
+      if (cleared) continue;
+      const bool inside = o.s >= C.qIn - ((o.flags & kStaged) ? 0.0f : 0.5f);   // a staged vehicle stops short: not inside
+      const float eta = tReach(o.v, C.qIn - o.s, V.amax);
+      const bool tie = fabsf(eta - etaSelf) < 0.2f;
+      const bool first = !inside && !(o.flags & kStaged) && eta < 2.0f && (eta < etaSelf - 0.2f || (tie && o.veh < self));
+      if (inside || first) wall = fminf(wall, C.pIn - s);
+    }
+  }
+  if (pedBusy(V, P.node, P.leg, now) && s < kCrossFrom) wall = fminf(wall, kCrossFrom - s);
+  if (pedBusy(V, P.node, P.exitLeg, now) && s < P.len - kCrossTo) wall = fminf(wall, P.len - kCrossTo - s);
+  if (holding && P.sWait > 0.0f) wall = fminf(wall, P.sWait - s);
+  return wall;
+}
+
+// Count overlaps: this vehicle and a vehicle on a conflicting path both inside the shared zone
+// (the training env's in-box collision test). Each overlapping pair is counted from both sides.
+__device__ void countOverlap(const View& V, int p, float s, int self) {
+  const Path& P = V.paths[p];
+  for (int c = 0; c < P.nConf; ++c) {
+    const Conf& C = V.conf[P.confStart + c];
+    if (C.kind == kDiverge || s < C.pIn + 0.5f || s - kVehLen > C.pOut - 0.5f) continue;
+    const int cnt = min(V.occCount[C.q], kOccCap);
+    for (int k = 0; k < cnt; ++k) {
+      const Occ& o = V.occ[C.q * kOccCap + k];
+      if (o.veh != self && (o.flags & kInBox) && o.s >= C.qIn + 0.5f && o.s - kVehLen <= C.qOut - 0.5f)
+        atomicAdd(&V.stats[kConflictOverlap], 1ull);
+    }
+  }
+}
+
+// Leader of a vehicle in the box: same path ahead, or a diverging path still in the shared start.
+__device__ void boxLeader(const View& V, int p, float s, int self, float* gap, float* vl) {
+  const Path& P = V.paths[p];
+  *gap = 1e9f; *vl = 0.0f;
+  auto scan = [&](int q, float zoneEnd) {
+    const int cnt = min(V.occCount[q], kOccCap);
+    for (int k = 0; k < cnt; ++k) {
+      const Occ& o = V.occ[q * kOccCap + k];
+      if (o.veh == self || !(o.flags & kInBox) || o.s <= s) continue;
+      if (zoneEnd >= 0.0f && o.s - kVehLen > zoneEnd) continue;
+      const float g = o.s - s;
+      if (g < *gap) { *gap = g; *vl = o.v; }
+    }
+  };
+  scan(p, -1.0f);
+  for (int c = 0; c < P.nConf; ++c) {
+    const Conf& C = V.conf[P.confStart + c];
+    if (C.kind == kDiverge) scan(C.q, C.qOut);
+  }
+}
+
+// ---------------------------------------------------------------- kernels
+// Signal phase per path, pedestrians (uses the previous step's occupancy lists).
+__global__ void kernel_ixControl(View V, float now, float dt) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= V.nNodes) return;
+  const Node& n = V.nodes[i];
+  if (V.debug && i == 0 && fmodf(now, 20.0f) < dt) {      // LPSIM_IX_DEBUG=1: occupancy of node 0
+    printf("[ix-debug] t=%.1f\n", now);
+    for (int p = 0; p < n.nPaths; ++p) {
+      const int q = n.pathStart + p, cnt = min(V.occCount[q], kOccCap);
+      for (int k = 0; k < cnt; ++k) {
+        const Occ& o = V.occ[q * kOccCap + k];
+        printf("  path %d (leg %d lane %d mov %d) veh %d s=%.1f v=%.1f rank=%.1f stop=%.1f flags=%d\n", p,
+               V.paths[q].leg, V.paths[q].lane, V.paths[q].mov, o.veh, o.s, o.v, o.rank, o.stopTime, o.flags);
+      }
+    }
+  }
+  int cur = 0;
+  float elapsed = 0.0f;
+  if (n.ctrl == kSignal && n.nPhase > 0) {
+    float tc = fmodf(now + n.offset, n.cycle), acc = 0.0f;
+    for (cur = 0; cur < n.nPhase - 1; ++cur) {
+      if (tc < acc + V.phaseDur[n.phaseStart + cur]) break;
+      acc += V.phaseDur[n.phaseStart + cur];
+    }
+    elapsed = tc - acc;
+    for (int p = 0; p < n.nPaths; ++p) {
+      const unsigned char st = V.phaseState[n.stateStart + cur * n.nPaths + p];
+      V.pathState[n.pathStart + p] = st;
+      float t = V.phaseDur[n.phaseStart + cur] - elapsed;      // time until this path's state changes
+      for (int j = 1; j < n.nPhase; ++j) {
+        const int k = (cur + j) % n.nPhase;
+        if (V.phaseState[n.stateStart + k * n.nPaths + p] != st) break;
+        t += V.phaseDur[n.phaseStart + k];
+      }
+      V.pathTts[n.pathStart + p] = t;
+    }
+  }
+  // pedestrians: Poisson arrivals (hash RNG), start crossing when walking is allowed and no
+  // vehicle is on the crosswalk span
+  for (int l = 0; l < n.nLegs; ++l) {
+    const Leg& L = V.legs[n.legStart + l];
+    if (L.pedRate <= 0.0f) continue;
+    unsigned int h = (unsigned int)(i * 2654435761u) ^ (unsigned int)(l * 40503u) ^ (unsigned int)(now * 1000.0f);
+    h ^= h >> 13; h *= 0x5bd1e995u; h ^= h >> 15;
+    const float u = (h & 0xFFFFFF) / 16777216.0f;
+    if (u < L.pedRate / 3600.0f * dt) V.pedWait[n.legStart + l] += 1.0f;
+    const bool walk = n.ctrl != kSignal ||
+                      (((V.phaseWalk[n.phaseStart + cur] >> l) & 1) && elapsed < 7.0f);
+    if (!walk || V.pedWait[n.legStart + l] <= 0.0f || V.pedBusyUntil[n.legStart + l] > now) continue;
+    bool occupied = false;
+    for (int p = 0; p < n.nPaths && !occupied; ++p) {
+      const Path& P = V.paths[n.pathStart + p];
+      const int cnt = min(V.occCount[n.pathStart + p], kOccCap);
+      for (int k = 0; k < cnt; ++k) {
+        const Occ& o = V.occ[(n.pathStart + p) * kOccCap + k];
+        if (!(o.flags & (kInBox | kGranted))) continue;
+        if ((P.leg == l && o.s > -1.0f && o.s < kCrossTo + 1.0f) ||
+            (P.exitLeg == l && o.s > P.len - kCrossTo - 1.0f && o.s < P.len)) { occupied = true; break; }
+      }
+    }
+    if (!occupied) {
+      V.pedBusyUntil[n.legStart + l] = now + L.crossTime;
+      V.pedWait[n.legStart + l] = 0.0f;
+    }
+  }
+}
+
+__device__ __forceinline__ void publish(const View& V, int path, float s, float v, float vmax, float r,
+                                        float stopTime, int veh, int flags) {
+  const int k = atomicAdd(&V.occCount[path], 1);
+  if (k < kOccCap) V.occ[path * kOccCap + k] = Occ{s, v, vmax, r, stopTime, veh, flags};
+  else atomicAdd(&V.stats[kOccOverflow], 1ull);
+}
+
+__device__ __forceinline__ void publishFar(const View& V, int path, float s, float v, float vmax, float r, int veh) {
+  const int k = atomicAdd(&V.occFarCount[path], 1);
+  if (k < kOccFarCap) V.occFar[path * kOccFarCap + k] = Occ{s, v, vmax, r, 0.0f, veh, 0};
+  else atomicAdd(&V.stats[kOccFarOverflow], 1ull);
+}
+
+// ---------------------------------------------------------------- host side
+struct Host {
+  std::vector<Node> nodes;
+  std::vector<Leg> legs;
+  std::vector<Path> paths;
+  std::vector<Conf> conf;
+  std::vector<float> phaseDur;
+  std::vector<int> phaseWalk;
+  std::vector<unsigned char> phaseState;
+  std::vector<int> edgeNode;
+};
+
+inline std::vector<std::vector<std::string>> readCsv(const std::string& file) {
+  std::vector<std::vector<std::string>> rows;
+  std::ifstream in(file);
+  if (!in) return rows;
+  std::string line;
+  std::getline(in, line);                      // header
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    if (line.empty()) continue;
+    std::vector<std::string> cols;
+    std::stringstream ss(line);
+    std::string c;
+    while (std::getline(ss, c, ',')) cols.push_back(c);
+    rows.push_back(cols);
+  }
+  return rows;
+}
+
+// edgeD(uniqueid) -> device edge index; returns false if the network has no ix_*.csv tables.
+template <typename EdgeD>
+bool load(const std::string& dir, int nEdges, EdgeD edgeD, Host& H) {
+  auto nodes = readCsv(dir + "ix_nodes.csv");
+  if (nodes.empty()) return false;
+  auto legs = readCsv(dir + "ix_legs.csv");
+  auto paths = readCsv(dir + "ix_paths.csv");
+  auto confs = readCsv(dir + "ix_conflicts.csv");
+  auto phases = readCsv(dir + "ix_phases.csv");
+  std::map<long long, int> nodeIdx;
+  H.edgeNode.assign(nEdges, -1);
+  for (auto& r : nodes) {
+    Node n{};
+    n.ctrl = std::stoi(r[1]); n.nLegs = std::stoi(r[2]); n.nPaths = std::stoi(r[3]);
+    n.nPhase = std::stoi(r[4]); n.rtor = std::stoi(r[5]); n.cycle = std::stof(r[7]);
+    n.offset = 0.0f;
+    nodeIdx[std::stoll(r[0])] = (int)H.nodes.size();
+    H.nodes.push_back(n);
+  }
+  for (auto& n : H.nodes) { n.legStart = -1; n.pathStart = -1; n.phaseStart = -1; }
+  for (auto& r : legs) {
+    Node& n = H.nodes[nodeIdx.at(std::stoll(r[0]))];
+    if (n.legStart < 0) n.legStart = (int)H.legs.size();
+    Leg L{};
+    const long long ie = std::stoll(r[3]), oe = std::stoll(r[4]);
+    L.inEdge = ie >= 0 ? edgeD(ie) : -1;
+    L.outEdge = oe >= 0 ? edgeD(oe) : -1;
+    L.major = std::stoi(r[5]); L.pedRate = std::stof(r[6]); L.crossTime = std::stof(r[7]);
+    if (L.inEdge >= 0 && L.inEdge < nEdges) H.edgeNode[L.inEdge] = nodeIdx.at(std::stoll(r[0]));
+    H.legs.push_back(L);
+  }
+  std::vector<std::vector<Conf>> confOf;
+  for (auto& r : paths) {
+    const int ni = nodeIdx.at(std::stoll(r[0]));
+    Node& n = H.nodes[ni];
+    if (n.pathStart < 0) n.pathStart = (int)H.paths.size();
+    Path P{};
+    P.node = ni; P.leg = std::stoi(r[2]); P.lane = std::stoi(r[3]); P.mov = std::stoi(r[4]);
+    P.exitLeg = std::stoi(r[5]); P.exitLane = std::stoi(r[6]);
+    P.inEdge = edgeD(std::stoll(r[7])); P.outEdge = edgeD(std::stoll(r[8])); P.len = std::stof(r[9]);
+    P.sWait = r.size() > 11 ? std::stof(r[10]) : -1.0f;
+    P.nStage = r.size() > 11 ? std::stoi(r[11]) : 0;
+    H.paths.push_back(P);
+  }
+  confOf.resize(H.paths.size());
+  std::map<std::pair<int, std::pair<int, int>>, std::pair<float, float>> zone;   // (node, p, q) -> zone on p
+  for (auto& r : confs) zone[{nodeIdx.at(std::stoll(r[0])), {std::stoi(r[1]), std::stoi(r[2])}}] = {std::stof(r[4]), std::stof(r[5])};
+  for (auto& r : confs) {
+    const int ni = nodeIdx.at(std::stoll(r[0]));
+    const int p = std::stoi(r[1]), q = std::stoi(r[2]);
+    const auto zp = zone.at({ni, {p, q}}), zq = zone.at({ni, {q, p}});
+    const int base = H.nodes[ni].pathStart;
+    confOf[base + p].push_back(Conf{base + q, std::stoi(r[3]), zp.first, zp.second, zq.first, zq.second});
+  }
+  for (size_t p = 0; p < H.paths.size(); ++p) {
+    H.paths[p].confStart = (int)H.conf.size();
+    H.paths[p].nConf = (int)confOf[p].size();
+    H.conf.insert(H.conf.end(), confOf[p].begin(), confOf[p].end());
+  }
+  for (auto& r : phases) {
+    const int ni = nodeIdx.at(std::stoll(r[0]));
+    Node& n = H.nodes[ni];
+    if (n.phaseStart < 0) { n.phaseStart = (int)H.phaseDur.size(); n.stateStart = (int)H.phaseState.size(); }
+    H.phaseDur.push_back(std::stof(r[2]));
+    H.phaseWalk.push_back(std::stoi(r[3]));
+    for (char c : r[4]) H.phaseState.push_back((unsigned char)(c - '0'));
+  }
+  for (auto& n : H.nodes) {                      // nodes without a signal plan
+    if (n.phaseStart < 0) { n.phaseStart = 0; n.stateStart = 0; n.nPhase = 0; }
+    if (n.pathStart < 0) n.pathStart = 0;
+  }
+  // stagger signal offsets deterministically
+  for (size_t i = 0; i < H.nodes.size(); ++i)
+    H.nodes[i].offset = H.nodes[i].cycle > 0 ? fmodf(37.0f * (float)i, H.nodes[i].cycle) : 0.0f;
+  if (H.phaseDur.empty()) { H.phaseDur.push_back(1.0f); H.phaseWalk.push_back(0); H.phaseState.push_back(0); }
+  return true;
+}
+
+template <typename T>
+T* upload(const std::vector<T>& v) {
+  T* d = nullptr;
+  cudaMalloc((void**)&d, std::max<size_t>(1, v.size()) * sizeof(T));
+  if (!v.empty()) cudaMemcpy(d, v.data(), v.size() * sizeof(T), cudaMemcpyHostToDevice);
+  return d;
+}
+
+inline View makeView(const Host& H) {
+  View V;
+  V.nNodes = (int)H.nodes.size(); V.nPaths = (int)H.paths.size(); V.nEdges = (int)H.edgeNode.size();
+  V.nodes = upload(H.nodes); V.legs = upload(H.legs); V.paths = upload(H.paths); V.conf = upload(H.conf);
+  V.phaseDur = upload(H.phaseDur); V.phaseWalk = upload(H.phaseWalk); V.phaseState = upload(H.phaseState);
+  V.edgeNode = upload(H.edgeNode);
+  cudaMalloc((void**)&V.pathState, std::max(1, V.nPaths));
+  cudaMemset(V.pathState, 0, std::max(1, V.nPaths));
+  cudaMalloc((void**)&V.pathTts, std::max(1, V.nPaths) * sizeof(float));
+  cudaMemset(V.pathTts, 0, std::max(1, V.nPaths) * sizeof(float));
+  cudaMalloc((void**)&V.occ, std::max(1, V.nPaths) * kOccCap * sizeof(Occ));
+  cudaMalloc((void**)&V.occCount, std::max(1, V.nPaths) * sizeof(int));
+  cudaMemset(V.occCount, 0, std::max(1, V.nPaths) * sizeof(int));
+  cudaMalloc((void**)&V.occFar, std::max(1, V.nPaths) * kOccFarCap * sizeof(Occ));
+  cudaMalloc((void**)&V.occFarCount, std::max(1, V.nPaths) * sizeof(int));
+  cudaMemset(V.occFarCount, 0, std::max(1, V.nPaths) * sizeof(int));
+  std::vector<float> busy(H.legs.size(), -1.0f), wait(H.legs.size(), 0.0f);
+  V.pedBusyUntil = upload(busy); V.pedWait = upload(wait);
+  cudaMalloc((void**)&V.stats, kNumStats * sizeof(unsigned long long));
+  cudaMemset(V.stats, 0, kNumStats * sizeof(unsigned long long));
+  return V;
+}
+
+}  // namespace ix
diff --git a/src/simulator/lc_policy.cuh b/src/simulator/lc_policy.cuh
new file mode 100644
index 0000000..255b540
--- /dev/null
+++ b/src/simulator/lc_policy.cuh
@@ -0,0 +1,54 @@
+// Lane-changing policy inference for LPSim's per-vehicle CUDA kernel.
+//
+// Include this header in cuda_traffic_sim.cu after generating lc_policy_weights.h with
+//   python -m lcrl.export_cuda --policy runs/<run>/policy.pt --out cuda/lc_policy_weights.h
+//
+// One thread evaluates one vehicle: ~8.5k multiply-adds, weights in __constant__ memory
+// (every lane of a warp reads the same weight at the same time -> broadcast).
+#pragma once
+#include "lc_policy_weights.h"
+
+// Lateral actions
+#define LC_LAT_KEEP 0   // keep lane / continue the ongoing change
+#define LC_LAT_LEFT 1   // start (or continue) a change to lane-1; aborts an ongoing right change
+#define LC_LAT_RIGHT 2  // start (or continue) a change to lane+1; aborts an ongoing left change
+
+// Acceleration offset (m/s^2) added to the IDM acceleration for each longitudinal action.
+__device__ __forceinline__ float lcLonDelta(int lon) {
+  const float d[LC_NUM_LON] = LC_LON_DELTAS;
+  return d[lon];
+}
+
+// obs:     LC_OBS_DIM features, built exactly as lcrl/env.py:LaneChangeEnv.observe()
+// latMask: lateral actions allowed by the safety shield (LC_LAT_KEEP must be allowed)
+// lat/lon: greedy actions
+__device__ inline void lcPolicyAct(const float* __restrict__ obs, const bool latMask[LC_NUM_LAT],
+                                   int& lat, int& lon) {
+  float h1[LC_HIDDEN], h2[LC_HIDDEN];
+#pragma unroll 4
+  for (int j = 0; j < LC_HIDDEN; ++j) {
+    float s = lc_b1[j];
+    for (int i = 0; i < LC_OBS_DIM; ++i) s += lc_W1[j * LC_OBS_DIM + i] * obs[i];
+    h1[j] = tanhf(s);
+  }
+#pragma unroll 4
+  for (int j = 0; j < LC_HIDDEN; ++j) {
+    float s = lc_b2[j];
+    for (int i = 0; i < LC_HIDDEN; ++i) s += lc_W2[j * LC_HIDDEN + i] * h1[i];
+    h2[j] = tanhf(s);
+  }
+  float best = -1e30f;
+  lat = LC_LAT_KEEP;
+  lon = 0;
+  for (int j = 0; j < LC_NUM_LAT + LC_NUM_LON; ++j) {
+    float s = lc_b3[j];
+    for (int i = 0; i < LC_HIDDEN; ++i) s += lc_W3[j * LC_HIDDEN + i] * h2[i];
+    if (j < LC_NUM_LAT) {
+      if (latMask[j] && s > best) { best = s; lat = j; }
+      if (j == LC_NUM_LAT - 1) best = -1e30f;
+    } else if (s > best) {
+      best = s;
+      lon = j - LC_NUM_LAT;
+    }
+  }
+}
