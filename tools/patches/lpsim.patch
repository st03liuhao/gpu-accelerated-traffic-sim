diff --git a/src/simulator/rl_lpsim.cuh b/src/simulator/rl_lpsim.cuh
new file mode 100644
index 0000000..42d1769
--- /dev/null
+++ b/src/simulator/rl_lpsim.cuh
@@ -0,0 +1,354 @@
+// RL lane-changing policy inside LPSim's vehicle kernel.
+//
+// Builds the same 68-feature observation as the training environments (lcrl/env.py,
+// lcrl/ix_env.py: config.EGO_FEATURES + 3 x LANE_FEATURES) from LPSim's 1 m lane map, runs the
+// exported policy (lc_policy.cuh + lc_policy_weights.h), and implements the trained action
+// space: 3 s lane changes that occupy both lanes and can be aborted, plus an acceleration offset
+// on top of IDM. Included by cuda_traffic_sim.cu after ix_lpsim.cuh. Enabled with the ini key
+// RL_LANE_CHANGE=true.
+#pragma once
+#include "lc_policy.cuh"
+#include "lane_geo.cuh"
+
+namespace rl {
+
+constexpr unsigned char kCarLen = 5, kTruckLen = 12;   // vehicle lengths (EnvConfig.veh_len / truck_len)
+constexpr float kLcDuration = 3.0f;
+constexpr float kDecisionDt = 0.5f;      // policy decision interval (EnvConfig.decision_dt)
+constexpr float kBlcSafe = 4.0f;         // max deceleration a lane change may impose (shield)
+constexpr float kBmax = 6.0f;
+constexpr float kNorm = 200.0f;          // distance normaliser (EnvConfig.obs_norm_range)
+// A vehicle stopped at its segment end outside the route lanes gives up after this long and drives
+// on (missing its route). Training ends every vehicle at its age limit, so the policy never learnt
+// to resolve two vehicles that each wait for the other's lane; the reward prices a miss as a 90 s
+// detour, so waiting longer is worse for the vehicle as well.
+constexpr float kGiveUpS = 30.0f;
+enum Cat { kFree = 0, kSignal = 1, kAwsc = 2, kTwscMajor = 3, kTwscMinor = 4, kYieldMinor = 5 };
+
+struct View {
+  int enabled = 0;
+  int rule = 0;                          // LPSIM_LC_RULE=1: the training env's rule baseline decides (same
+                                         // segment, observation, shield and lane-change motion as RL)
+  int substeps = 1;                      // physics steps per policy decision
+  uchar* intentMap = nullptr;            // same layout as laneMap: bit7 set, bit6 = right, bits0-5 urgency
+  unsigned char* lenMap = nullptr;       // = lg::View::lenMap (vehicle lengths)
+  const unsigned char* edgeFromIx = nullptr;   // edge_d starts at a controlled intersection
+  unsigned long long* stats = nullptr;         // [lcrl-rl] 0: lane changes started, 1: aborts
+  float* dbgObs = nullptr;                     // LPSIM_RL_DUMP=1: observations at aborts + a 0.2% sample
+  int* dbgCount = nullptr;
+  int dbgCap = 0;
+};
+
+__device__ __forceinline__ uint cellIdx(uint shift, uint edge, int lane, int b, int numLines) {
+  return shift + kMaxMapWidthM * (edge + (b / kMaxMapWidthM) * numLines + lane) + b % kMaxMapWidthM;
+}
+
+__device__ __forceinline__ float hash01(unsigned int x) {
+  x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+  return (x & 0xFFFFFF) / 16777216.0f;
+}
+
+// per-vehicle traits drawn like the training env (EnvConfig.aggr_range / info_range / truck_share)
+__device__ void initTraits(LC::B18TrafficVehicle& v, int p) {
+  const unsigned int s = (unsigned int)v.id * 9781u + (unsigned int)p * 6271u;
+  v.rlAggr = hash01(s + 1);
+  v.rlInfo = 50.0f + 150.0f * hash01(s + 2);
+  const bool truck = hash01(s + 3) < 0.12f;
+  v.vlen = truck ? kTruckLen : kCarLen;
+  v.rlVdesFactor = truck ? 0.55f + 0.2f * hash01(s + 4)
+                         : (0.9f + 0.2f * hash01(s + 5)) * (0.95f + 0.1f * v.rlAggr);
+  v.lcFrom = v.lcTo = v.numOfLaneInEdge;
+  v.lcProg = 0.0f;
+}
+
+__device__ __forceinline__ uchar encodeIntent(int dir, float urgency) {
+  if (dir == 0) return 0;
+  return (uchar)(0x80 | (dir > 0 ? 0x40 : 0) | (int)(fminf(fmaxf(urgency, 0.0f), 1.0f) * 63.0f));
+}
+
+// distances on a log scale (lcrl.config.dist_feature): log(1 + d/50) / log(1 + 2000/50), in [0, 1]
+__device__ __forceinline__ float distFeature(float d) {
+  return fminf(log1pf(fmaxf(d, 0.0f) / 50.0f) / 3.7135721f, 1.0f);
+}
+
+struct LaneScan {
+  float leadGap, leadV, leadIntent, lagGap, lagV, lagIntent, count, speedSum, bestGap, bestPos;
+  bool hasLead, hasLag;
+};
+
+// ---------------------------------------------------------------------------------------------
+// The vehicle's segment ("chain"): the current edge plus the edges ahead on its path through
+// nodes where every lane continues and no lane has to be chosen (no intersection control, no
+// diverge, no lane drop), up to kLookahead. It plays the role of the training env's road
+// segment: the deadline, the lane runways and the route lanes are measured to its end, and the
+// neighbour search runs along it. Positions are relative to the vehicle (negative = behind).
+constexpr int kMaxChain = 24;
+constexpr int kMaxBack = 4;
+constexpr float kLookahead = 2000.0f;    // the distance features saturate at 2 km (distFeature)
+constexpr int kLaneLo = -8, kLaneHi = 16; // lane indices (of the current edge) considered for route lanes
+
+struct Seg {
+  int edge, nl;                          // edge_d and its lane count
+  float len, base;                       // length; position of its start relative to the vehicle
+  int shift;                             // lane k of the current edge is lane k + shift here
+};
+
+struct Chain {
+  int n, nBack;
+  Seg seg[kMaxChain];                    // seg[0] = current edge
+  Seg back[kMaxBack];                    // upstream edges on the path (lag search), nearest first
+  float end;                             // distance from the vehicle to the segment end
+  unsigned okMask;                       // lanes of the last edge that serve the route at the end
+};
+
+struct LaneRun {                         // one lane (current-edge index) along the chain
+  bool any, exists, reachesEnd;
+  float start, end;                      // relative to the vehicle
+};
+
+// The lane's run that has not ended behind the vehicle: a slot can hold a lane that ended behind
+// (e.g. an acceleration lane already passed) and a later one (the next ramp's deceleration lane).
+__device__ LaneRun laneRun(const lg::View& G, const Chain& C, int k0) {
+  LaneRun r{};
+  r.start = 1e9f; r.end = -1e9f;
+  bool started = false;
+  for (int i = 0; i < C.n; ++i) {
+    const Seg& S = C.seg[i];
+    const int kk = k0 + S.shift;
+    const float2 sp = (kk < 0 || kk >= S.nl) ? make_float2(0.0f, 0.0f) : lg::span(G, S.edge, kk, S.len);
+    if (sp.y <= sp.x) {                  // no lane here
+      if (started && r.end > 0.0f) break;
+      started = false;
+      continue;
+    }
+    if (started && sp.x > 0.5f) {        // interrupted at the node
+      if (r.end > 0.0f) break;
+      started = false;
+    }
+    if (!started) { started = true; r.start = S.base + sp.x; }
+    r.end = S.base + sp.y;
+    if (sp.y < S.len - 1.0f) {           // ends inside this edge
+      if (r.end > 0.0f) break;
+      started = false;                   // ended behind the vehicle: look for a later run
+      continue;
+    }
+    if (i == C.n - 1) r.reachesEnd = true;
+  }
+  if (!started) { r.start = 1e9f; r.end = -1e9f; r.reachesEnd = false; }
+  r.any = started;
+  r.exists = started && r.start <= 0.0f && r.end >= 0.0f;
+  return r;
+}
+
+__device__ __forceinline__ bool routeOk(const Chain& C, const LaneRun& r, int k0) {
+  const int kk = k0 + C.seg[C.n - 1].shift;
+  return r.reachesEnd && kk >= 0 && kk < 32 && ((C.okMask >> kk) & 1u);
+}
+
+// route lanes as bits (bit j - kLaneLo = current-edge lane j)
+__device__ unsigned routeBits(const lg::View& G, const Chain& C) {
+  unsigned bits = 0;
+  for (int j = kLaneLo; j < kLaneHi; ++j)
+    if (routeOk(C, laneRun(G, C, j), j)) bits |= 1u << (j - kLaneLo);
+  return bits;
+}
+
+// signed number of lanes from k to the nearest route lane (ties: the lower index, as torch argmin)
+__device__ int lanesToOk(unsigned bits, int k) {
+  int best = 0, bestAbs = 1 << 20;
+  for (int j = kLaneLo; j < kLaneHi; ++j) {
+    if (!((bits >> (j - kLaneLo)) & 1u)) continue;
+    const int d = j - k;
+    if (abs(d) < bestAbs) { bestAbs = abs(d); best = d; }
+  }
+  return best;
+}
+
+// Scan lane k0 (current-edge index) along the chain within the vehicle's information range.
+//   targetCenter: the ego centre lane (intent toward it counts); laneEnd: where the lane ends
+__device__ LaneScan scanLane(const uchar* laneMap, const uchar* intentMap, const lg::View& G, uint shift,
+                             const Chain& C, int k0, float pos, float info, int targetCenter, float laneEnd,
+                             float egoLen) {
+  LaneScan r{};
+  r.leadGap = r.lagGap = 1e9f;
+  r.bestGap = -1.0f;
+  const int b0 = (int)pos;
+  bool havePrev = false;                 // previous occupied cell while sweeping forward
+  float prevPos = 0.0f;
+  for (int q = -C.nBack; q < C.n; ++q) { // pieces from the farthest upstream edge to the chain end
+    const Seg& S = q < 0 ? C.back[-q - 1] : C.seg[q];
+    const int kk = k0 + S.shift;
+    if (kk < 0 || kk >= S.nl) continue;
+    const int lo = max(0, (int)floorf(-info - S.base)), hi = min((int)ceilf(S.len) - 1, (int)floorf(info - S.base));
+    for (int b = lo; b <= hi; ++b) {
+      if (q == 0 && b == b0) continue;
+      const uint idx = cellIdx(shift, S.edge, kk, b, S.nl);
+      const uchar c = laneMap[idx];
+      if (c == 0xFF) continue;
+      const float x = S.base + b;        // relative position
+      const float vv = c / 3.0f;
+      const uchar in = intentMap[idx];
+      const int dir = (in & 0x80) ? ((in & 0x40) ? 1 : -1) : 0;
+      const float urg = (in & 0x3F) / 63.0f;
+      const float intentToMe = (dir != 0 && k0 + dir == targetCenter) ? urg : 0.0f;
+      if (q > 0 || (q == 0 && b > b0)) {
+        if (!r.hasLead) { r.hasLead = true; r.leadGap = x - lg::lenAt(G, idx); r.leadV = vv; r.leadIntent = intentToMe; }
+        if (x < info) { r.count += 1.0f; r.speedSum += vv; }
+      } else {
+        r.hasLag = true; r.lagGap = -x - egoLen; r.lagV = vv; r.lagIntent = intentToMe;   // last one before ego
+      }
+      if (havePrev) {                    // gap in front of the previous vehicle
+        const float g = fminf((x - prevPos) - lg::lenAt(G, idx), info);
+        if (g > r.bestGap) { r.bestGap = g; r.bestPos = prevPos + 0.5f * g; }
+      }
+      havePrev = true; prevPos = x;
+    }
+  }
+  if (havePrev) {                        // gap in front of the last vehicle (open to the lane end / range)
+    const float g = fminf(laneEnd - prevPos, info);
+    if (g > r.bestGap) { r.bestGap = g; r.bestPos = prevPos + 0.5f * g; }
+  }
+  if (r.bestGap < 0.0f) { r.bestGap = info; r.bestPos = 0.0f; }
+  return r;
+}
+
+// Leader only (first vehicle ahead in lane k0 within the information range), as scanLane's lead
+// fields. Used between decisions, while a lane change follows leaders in both lanes.
+__device__ LaneScan leadInLane(const uchar* laneMap, const lg::View& G, uint shift, const Chain& C, int k0, float pos,
+                               float info) {
+  LaneScan r{};
+  r.leadGap = r.lagGap = 1e9f;
+  const int b0 = (int)pos;
+  for (int q = 0; q < C.n; ++q) {
+    const Seg& S = C.seg[q];
+    const int kk = k0 + S.shift;
+    if (kk < 0 || kk >= S.nl) continue;
+    const int lo = max(q == 0 ? b0 + 1 : 0, (int)floorf(-info - S.base));
+    const int hi = min((int)ceilf(S.len) - 1, (int)floorf(info - S.base));
+    for (int b = lo; b <= hi; ++b) {
+      const uint idx = cellIdx(shift, S.edge, kk, b, S.nl);
+      const uchar c = laneMap[idx];
+      if (c == 0xFF) continue;
+      r.hasLead = true; r.leadGap = S.base + b - lg::lenAt(G, idx); r.leadV = c / 3.0f;
+      return r;
+    }
+  }
+  return r;
+}
+
+struct Ctx {                             // intersection context for the observation
+  int cat;                               // Cat
+  float rankHalf, blocked, tts, stopped; // ego rank / 2, ...
+  int mov;                               // intended movement class
+  int K;                                 // lane slots of the matching training env (6 freeway, 8 intersection)
+};
+
+// training env _safe_to_enter: lane exists here, > 15 m of it left, > 10 m to the segment end, safe gaps
+__device__ __forceinline__ bool safeToEnter(const LC::B18TrafficVehicle& v, const Chain& C, const LaneRun& run,
+                                            const LaneScan& s) {
+  bool ok = run.exists && run.end > 15.0f && C.end > 10.0f;
+  if (ok && s.hasLead) ok &= s.leadGap >= 1.38f && (v.v * v.v - s.leadV * s.leadV) / (2 * kBlcSafe) <= s.leadGap - 1.38f;
+  if (ok && s.hasLag) ok &= s.lagGap >= 1.38f && (s.lagV * s.lagV - v.v * v.v) / (2 * kBlcSafe) + s.lagV * 0.5f <= s.lagGap - 1.38f;
+  return ok;
+}
+
+// Observation (lcrl config layout) and the lateral action mask (keep / left / right).
+// Also returns the deadline and the signed lanes to the nearest route lane (turn indicator).
+__device__ void buildObs(const LC::B18TrafficVehicle& v, const uchar* laneMap, const uchar* intentMap, uint shift,
+                         const lg::View& G, const Chain& C, float vmaxEdge, const Ctx& cx, bool exitStart,
+                         float* obs, bool* mask, LaneScan* scans, float* deadlineOut, int* needOut) {
+  const float lim = fmaxf(vmaxEdge, 1.0f);
+  const int c = v.numOfLaneInEdge;
+  const bool inLc = v.lcFrom != v.lcTo;
+  const int lcDir = inLc ? (v.lcTo > v.lcFrom ? 1 : -1) : 0;
+  LaneRun runs[3];
+  for (int d = -1; d <= 1; ++d) runs[d + 1] = laneRun(G, C, c + d);
+  const float deadline = fminf(runs[1].end, C.end);
+  const unsigned okBits = routeBits(G, C);
+  const int need = lanesToOk(okBits, c);
+  *deadlineOut = deadline;
+  *needOut = need;
+  int i = 0;
+  obs[i++] = v.v / lim;
+  obs[i++] = v.rlVdesFactor;
+  obs[i++] = v.rlAggr;
+  obs[i++] = v.rlInfo / kNorm;
+  obs[i++] = v.lcProg;
+  obs[i++] = (float)lcDir;
+  obs[i++] = fminf(fmaxf((float)need, -3.0f), 3.0f) / 3.0f;
+  obs[i++] = distFeature(deadline);
+  obs[i++] = distFeature(C.end);
+  for (int k = 0; k < 6; ++k) obs[i++] = cx.cat == k ? 1.0f : 0.0f;
+  obs[i++] = cx.rankHalf;
+  obs[i++] = cx.blocked;
+  obs[i++] = fminf(fmaxf(cx.tts / 60.0f, 0.0f), 1.0f);
+  obs[i++] = cx.stopped;
+  for (int m = 0; m < 3; ++m) obs[i++] = cx.mov == m ? 1.0f : 0.0f;
+  obs[i++] = v.rlPrevAccel / 3.0f;
+  for (int d = -1; d <= 1; ++d) {
+    const int k = c + d;
+    const LaneRun& run = runs[d + 1];
+    // a lane slot the training env would have (index 0..K-1), or one that exists somewhere ahead
+    const bool valid = (k >= 0 && k < cx.K) || run.any;
+    LaneScan s{};
+    if (valid) s = scanLane(laneMap, intentMap, G, shift, C, k, v.posInLaneM, v.rlInfo, c, run.end, (float)v.vlen);
+    scans[d + 1] = s;
+    const float info = v.rlInfo;
+    const bool hasLead = valid && s.hasLead && s.leadGap < info, hasLag = valid && s.hasLag && s.lagGap < info;
+    obs[i++] = valid && run.exists ? 1.0f : 0.0f;                                     // exists
+    obs[i++] = valid ? distFeature(run.end) : 0.0f;                                   // runway
+    obs[i++] = valid && run.any ? distFeature(run.start) : 0.0f;                      // starts_ahead
+    obs[i++] = valid && routeOk(C, run, k) ? 1.0f : 0.0f;                             // route_ok
+    obs[i++] = valid ? fminf((float)abs(lanesToOk(okBits, k)), 3.0f) / 3.0f : 0.0f;   // lanes_to_ok
+    obs[i++] = valid ? fminf(fmaxf(hasLead ? s.leadGap : info, -5.0f), kNorm) / kNorm : 0.0f;
+    obs[i++] = valid && hasLead ? (s.leadV - v.v) / 10.0f : 0.0f;
+    obs[i++] = valid && hasLead ? s.leadIntent : 0.0f;
+    obs[i++] = valid ? fminf(fmaxf(hasLag ? s.lagGap : info, -5.0f), kNorm) / kNorm : 0.0f;
+    obs[i++] = valid && hasLag ? (s.lagV - v.v) / 10.0f : 0.0f;
+    obs[i++] = valid && hasLag ? s.lagIntent : 0.0f;
+    obs[i++] = valid ? s.count / 10.0f : 0.0f;
+    obs[i++] = valid ? (s.count > 0 ? s.speedSum / s.count : lim) / lim : 0.0f;
+    obs[i++] = valid ? fminf(s.bestGap, kNorm) / 100.0f : 0.0f;
+    obs[i++] = valid ? fminf(fmaxf(s.bestPos, -kNorm), kNorm) / kNorm : 0.0f;
+  }
+  // safety shield: physically safe gaps, lane exists with > 15 m left, not near the segment end,
+  // not just after the box
+  mask[0] = true;
+  for (int side = 0; side < 2; ++side) {
+    const int d = side == 0 ? -1 : 1;
+    mask[1 + side] = !inLc && !v.ixGranted && !(exitStart && v.posInLaneM <= 30.0f) &&
+                     safeToEnter(v, C, runs[d + 1], scans[d + 1]);
+  }
+  if (inLc) {                          // continuing is always allowed; aborting only once continuing became unsafe
+    const int dTo = (int)v.lcTo - c;   // target lane relative to the centre lane (0 once past halfway)
+    const bool safe = safeToEnter(v, C, runs[dTo + 1], scans[dTo + 1]);
+    mask[lcDir < 0 ? 1 : 2] = true;
+    mask[lcDir < 0 ? 2 : 1] = !safe;
+  }
+}
+
+// The training env's rule baseline (lcrl/env.py rule_action), on the same observation and shield:
+// change toward the route lane as soon as the shield allows; otherwise change discretionarily when
+// held up by a close leader (one slower than the ego, or the ego below 80% of its desired speed)
+// and an adjacent lane that serves the route has a longer gap; no acceleration offset (pure IDM).
+__device__ inline void ruleAct(const float* obs, const bool* mask, int& lat, int& lon) {
+  constexpr int kEgo = 23, kLane = 15;   // EGO_FEATURES, LANE_FEATURES; lanes left / current / right
+  constexpr int kExists = 0, kLanesToOk = 4, kLeadGap = 5, kLeadDv = 6;
+  const float need = obs[6], lcProg = obs[4];
+  const float* cur = obs + kEgo + kLane;
+  const float lead0 = cur[kLeadGap], dv0 = cur[kLeadDv];
+  lat = LC_LAT_KEEP;
+  const bool slow = lead0 < 0.25f && (dv0 < -0.2f || obs[0] < 0.8f * obs[1]);
+  for (int side = 0; side < 2; ++side) {         // left first, as in the env
+    const float* L = obs + kEgo + (side == 0 ? 0 : 2) * kLane;
+    const int a = side == 0 ? LC_LAT_LEFT : LC_LAT_RIGHT;
+    if (lat == LC_LAT_KEEP && slow && L[kLanesToOk] == 0.0f && L[kExists] > 0.0f &&
+        L[kLeadGap] > lead0 + 0.1f && mask[a]) lat = a;
+  }
+  if (need < -0.1f && mask[LC_LAT_LEFT]) lat = LC_LAT_LEFT;
+  if (need > 0.1f && mask[LC_LAT_RIGHT]) lat = LC_LAT_RIGHT;
+  if (lcProg > 0.0f) lat = LC_LAT_KEEP;
+  lon = 2;                                       // LON_NEUTRAL
+}
+
+}  // namespace rl
