+// [lcrl-rl] lanes of `edge` that exist at its end
+__device__ unsigned rlAliveAtEnd(const lg::View& G, int edge, int nl, float len) {
+  unsigned m = 0;
+  for (int k = 0; k < nl && k < 32; ++k) {
+    const float2 sp = lg::span(G, edge, k, len);
+    if (sp.y > sp.x && sp.y >= len - 1.0f) m |= 1u << k;
+  }
+  return m;
+}
